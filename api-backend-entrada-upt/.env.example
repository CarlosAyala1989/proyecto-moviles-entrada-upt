PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
# Ruta opcional al navegador usado para verificar la intranet mediante Playwright.
# En Linux local se detectan automáticamente google-chrome y chromium.
# CHROME_EXECUTABLE=/usr/bin/google-chrome
# CHROME_NO_SANDBOX=false
# El proceso y cada sesión MariaDB usan esta zona para el día operativo.
TZ=America/Lima

# OAuth 2.0 de tipo "Aplicación web". El secreto permanece sólo en Node.
# Registra este URI exacto en Google Cloud para ejecutar Flutter en Linux.
GOOGLE_OAUTH_CLIENT_ID=cliente.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=reemplazar_por_el_secreto
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/registro-estudiante/google/callback
GOOGLE_WORKSPACE_DOMAIN=virtual.upt.pe

# En Docker Compose normalmente se usa el nombre del servicio, por ejemplo: mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nombre_base_datos
DB_USER=usuario_api
DB_PASSWORD=cambiar_esta_clave
DB_CONNECTION_LIMIT=10

# Valores provisionales y configurables; no constituyen reglas oficiales de la UPT.
DURACION_TOKEN_ACCESO_MINUTOS=15
DURACION_TOKEN_RENOVACION_DIAS=7
MAX_INTENTOS_INICIO_SESION=5
DURACION_BLOQUEO_MINUTOS=15

# El script de administrador inicial exige una contraseña robusta de 14 caracteres.
ADMIN_INICIAL_CODIGO=ADMIN-DESARROLLO
ADMIN_INICIAL_CORREO=administrador@example.invalid
ADMIN_INICIAL_NOMBRES=Administrador
ADMIN_INICIAL_APELLIDOS=De Desarrollo
ADMIN_INICIAL_CONTRASENA=reemplazar_por_contrasena_robusta
