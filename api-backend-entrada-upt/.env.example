PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# En Docker Compose normalmente se usa el nombre del servicio, por ejemplo: mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nombre_base_datos
DB_USER=usuario_api
DB_PASSWORD=cambiar_esta_clave
DB_CONNECTION_LIMIT=10

# Solo para Hito 3 local. Generar un valor aleatorio de al menos 32 caracteres.
CLAVE_ADMINISTRACION_DESARROLLO=reemplazar_por_valor_aleatorio

# El script de administrador inicial exige una contraseña robusta de 14 caracteres.
ADMIN_INICIAL_CODIGO=ADMIN-DESARROLLO
ADMIN_INICIAL_CORREO=administrador@example.invalid
ADMIN_INICIAL_NOMBRES=Administrador
ADMIN_INICIAL_APELLIDOS=De Desarrollo
ADMIN_INICIAL_CONTRASENA=reemplazar_por_contrasena_robusta
